{
  "rules": {
    "classes": {
      "$code": {
        ".read": "$code.length >= 6",
        "students": {
          "$name": {
            ".write": "$code.length >= 6",
            ".validate": "newData.hasChildren(['name','total','ko','en']) && newData.child('name').isString() && newData.child('name').val().length <= 12 && newData.child('total').isNumber() && newData.child('total').val() >= 0 && newData.child('total').val() <= 1000 && newData.child('keys').isNumber()"
          }
        },
        "backup": {
          "$name": {
            ".write": "$code.length >= 6",
            ".validate": "newData.hasChild('name') && newData.child('name').isString()"
          }
        },
        "info": {
          ".write": "$code.length >= 6 && !data.exists() && auth != null && root.child('teachers/'+auth.uid).val() === true",
          ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 20"
        },
        "chat": {
          ".write": "auth != null && root.child('teachers/'+auth.uid).val() === true",
          "$id": {
            ".write": "$code.length >= 6 && ((!data.exists() && newData.exists() && root.child('classes/'+$code+'/settings/chatOff').val() !== true) || (auth != null && root.child('teachers/'+auth.uid).val() === true))",
            ".validate": "newData.hasChildren(['name','text','t']) && newData.child('name').isString() && newData.child('name').val().length <= 12 && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 60 && newData.child('t').isNumber()"
          }
        },
        "settings": {
          ".write": "auth != null && root.child('teachers/'+auth.uid).val() === true",
          "chatOff": {
            ".validate": "newData.isBoolean()"
          }
        },
        "boss": {
          ".write": "auth != null && root.child('teachers/'+auth.uid).val() === true",
          "on": {
            ".validate": "newData.isBoolean()"
          },
          "hp": {
            ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 100000"
          },
          "dur": {
            ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 900"
          },
          "hits": {
            "$k": {
              ".validate": "newData.hasChildren(['name','dmg','id']) && newData.child('name').isString() && newData.child('name').val().length <= 12 && newData.child('dmg').isNumber() && newData.child('dmg').val() >= 0 && newData.child('dmg').val() <= 100000",
              ".write": "$code.length >= 6"
            }
          }
        }
      }
    },
    "teachers": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && ((!root.child('teachers').exists() && auth.uid === $uid) || root.child('teachers/'+auth.uid).val() === true)",
        ".validate": "newData.isBoolean()"
      }
    },
    "teacherInfo": {
      "$uid": {
        ".read": "auth != null && root.child('teachers/'+auth.uid).val() === true",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "teacherReq": {
      ".read": "auth != null && root.child('teachers/'+auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('teachers/'+auth.uid).val() === true)",
        ".validate": "!newData.exists() || (newData.child('email').isString() && newData.child('email').val().length <= 80)"
      }
    }
  }
}